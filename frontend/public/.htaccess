<IfModule mod_rewrite.c>
    RewriteEngine On

    # File/folder asli (aset, gambar) langsung diserve
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Selain itu fallback ke index.html (Vue Router history mode)
    RewriteRule ^ index.html [L]
</IfModule>
